{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://talkotype.app",
          "https://www.talkotype.app",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "Content-Length"]
      },
      "exposeHeaders": ["ETag", "Content-Type", "Content-Length"],
      "maxAgeSeconds": 86400
    }
  ]
}
