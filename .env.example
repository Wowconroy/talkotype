# Talkotype Supabase (project: talkotype — do not reuse warehouse-app)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (auth redirects)
NEXT_PUBLIC_SITE_URL=https://talkotype.app

# Cloudflare R2 (private media). Create an R2 bucket + API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=talkotype-media

# Transcription — Whisper is the default engine (via Groq)
GROQ_API_KEY=
TRANSCRIPTION_PROVIDER=whisper
TRANSCRIPTION_MODEL=whisper-large-v3

# Fly FFmpeg worker (long files / probe / chunk). When both are set,
# complete-upload dispatches here instead of the Vercel process route.
TRANSCRIPTION_WORKER_URL=https://talkotype-worker.fly.dev
TRANSCRIPTION_WORKER_SECRET=generate_a_long_random_string
# Same secret on the worker:
# WORKER_SHARED_SECRET=generate_a_long_random_string

# Required for Unlimited "Recognize speakers" only. Default ASR stays Groq Whisper.
# Speaker jobs use AssemblyAI Universal-2 with speaker_labels + speakers_expected.
ASSEMBLYAI_API_KEY=

# Vercel Cron auth for /api/cron/purge-expired-media (set in Vercel project env).
# Vercel sends Authorization: Bearer <CRON_SECRET> on scheduled invokes.
CRON_SECRET=generate_a_long_random_string

# Paddle Billing — start in sandbox, then flip NEXT_PUBLIC_PADDLE_ENV=production
# Dashboard: https://sandbox-vendors.paddle.com
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
PADDLE_API_KEY=
# Secret from Developer Tools → Notifications destination
PADDLE_WEBHOOK_SECRET=
